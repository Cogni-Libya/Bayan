% bayan.sty -- the SIC AI Capstone Final Report template, rebuilt in LaTeX.
%
% Every measurement below is taken from the template's own document.xml:
%   page      A4; margins top 1701tw, left/right/bottom 1440tw
%   banner    fill 193DB0, SamsungOne-700 14pt white, text inset 142tw
%   headings  SamsungOne-400 11pt black, inset 427tw -- the body inset too
%   contents  "Content" in Samsung Sharp Sans 24pt 193DB0; entries 12pt/11pt
%   tables    header fill DEE5FA, rules BFBFBF 0.5pt, SamsungOne-700 12pt
%   footer    "Page N / M", right-aligned, inset 400tw
% The cover is the template's page 1 itself (assets/sic_cover.pdf); fonts come
% from the template via extract_template_assets.py and fall back to Liberation
% Sans when absent.
\ProvidesPackage{bayan}[2026/09/23 SIC final report template]

\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\RequirePackage[table]{xcolor}
\RequirePackage[explicit]{titlesec}
\RequirePackage{titletoc}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{makecell}
\RequirePackage{caption}
\RequirePackage{graphicx}
\RequirePackage{pdfpages}
\RequirePackage{changepage}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\RequirePackage{enumitem}
\RequirePackage[hidelinks]{hyperref}

\usetikzlibrary{arrows.meta, positioning, fit, backgrounds, calc, shapes.geometric, shadows, matrix}
\pgfplotsset{compat=1.18, /pgf/number format/assume math mode=true,
  every axis/.append style={/pgf/number format/1000 sep={,}}}

% ---------------------------------------------------------------- palette --
\definecolor{sicblue}{HTML}{193DB0}   % banners, "Content", table categories
\definecolor{sichead}{HTML}{DEE5FA}   % table header fill
\definecolor{sicrule}{HTML}{BFBFBF}   % table rules, placeholder text
\definecolor{sicbody}{HTML}{000000}   % body text
% Two figure hues beyond the template's own, used only inside charts.
\definecolor{figgrey}{HTML}{8C8C8C}
\definecolor{figwarm}{HTML}{C2410C}
\definecolor{figpale}{HTML}{EEF2FC}

% ------------------------------------------------------------------ fonts --
\setmainlanguage{english}
\setotherlanguage{arabic}
\newfontfamily\arabicfont[Script=Arabic,
  Path=/usr/share/fonts/paktype-naskh-basic-fonts/, Extension=.ttf]{PakTypeNaskhBasic}
\newcommand{\ar}[1]{\textarabic{#1}}

\IfFileExists{fonts/SamsungOne-400.ttf}{%
  \setmainfont[Path=fonts/, Extension=.ttf, BoldFont=SamsungOne-700,
    ItalicFont=SamsungOne-400, ItalicFeatures={FakeSlant=0.18}]{SamsungOne-400}
  \newfontfamily\sicsharp[Path=fonts/, Extension=.ttf]{SamsungSharpSans-Bold}
}{%
  \setmainfont[Path=/usr/share/fonts/liberation-sans-fonts/, Extension=.ttf,
    BoldFont=LiberationSans-Bold, ItalicFont=LiberationSans-Italic,
    BoldItalicFont=LiberationSans-BoldItalic]{LiberationSans-Regular}
  \newcommand{\sicsharp}{\bfseries}
}
\setmonofont[Path=/usr/share/fonts/liberation-mono-fonts/, Extension=.ttf,
  BoldFont=LiberationMono-Bold, Scale=0.88]{LiberationMono-Regular}

% ------------------------------------------------------------------- page --
% The body is inset 427tw (7.5mm) from the banner edge, so the text block
% starts there and the banners, contents and review tables reach back out.
\newlength{\sicinset}\setlength{\sicinset}{7.5mm}
\geometry{a4paper, top=30mm, bottom=25.4mm, right=25.4mm,
          left=\dimexpr25.4mm+\sicinset\relax, footskip=14.5mm}
\newenvironment{fullwidth}{\begin{adjustwidth}{-\sicinset}{0pt}}{\end{adjustwidth}}

\AtBeginDocument{\fontsize{10.5}{14.2}\selectfont\color{sicbody}}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 1pt}
\setlist{leftmargin=5mm, itemsep=1pt, topsep=2pt}

% ----------------------------------------------------------------- footer --
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[R]{\fontsize{10}{12}\selectfont Page\enspace\thepage\ / \pageref*{LastPage}\hspace*{7mm}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[R]{\fontsize{10}{12}\selectfont
  Page\enspace\thepage\ / \pageref*{LastPage}\hspace*{7mm}}}

% --------------------------------------------------------------- headings --
\titleformat{\section}{\normalfont}{}{0pt}{%
  \hspace*{-\sicinset}\colorbox{sicblue}{%
    \parbox[c][5.4mm][c]{\dimexpr\textwidth+\sicinset-2\fboxsep\relax}{%
      \hspace*{2.5mm}\fontsize{14}{16}\selectfont\bfseries\color{white}%
      \thesection.\ #1}}}
\titlespacing*{\section}{0pt}{16pt plus 3pt minus 2pt}{8pt}

\titleformat{\subsection}{\normalfont\fontsize{11}{14}\selectfont}
  {\thesubsection.}{0.3em}{#1}
\titlespacing*{\subsection}{0pt}{11pt plus 2pt minus 2pt}{3pt}

% Unnumbered run-in label for paragraphs inside a subsection.
\newcommand{\lead}[1]{\textbf{#1}\enspace}

% --------------------------------------------------------------- contents --
\setcounter{tocdepth}{2}
\titlecontents{section}[0pt]{\addvspace{10pt}\fontsize{12}{14}\selectfont\bfseries}
  {\thecontentslabel.\ }{}{}[\vspace{3pt}]
\titlecontents{subsection}[5mm]{\fontsize{11}{13}\selectfont}
  {\thecontentslabel.\ }{}{}[\vspace{3pt}]
\newcommand{\siccontents}{%
  \begin{fullwidth}
  \begin{center}{\sicsharp\fontsize{24}{28}\selectfont\color{sicblue}Content}\end{center}
  \vspace{2mm}
  \@starttoc{toc}
  \end{fullwidth}\clearpage}

% ------------------------------------------------------------ cover pages --
% Page 1 is the template's own cover. Page 2 places the title, date, team and
% members where the template's content controls sit.
\newcommand{\siccover}[4]{% {title}{date DD/MM/YY}{team}{members, \\-separated}
  \includepdf[pages=1, pagecommand={\thispagestyle{empty}}]{assets/sic_cover.pdf}
  \thispagestyle{plain}
  \begin{tikzpicture}[remember picture, overlay]
    \coordinate (tl) at ([xshift=25.4mm, yshift=-36mm]current page.north west);
    \draw[sicrule, line width=0.5pt] (tl) rectangle ++(159.2mm, -30.7mm);
    \node[align=center, text width=150mm, font=\bfseries\fontsize{20}{25}\selectfont]
      at ([xshift=79.6mm, yshift=-15.35mm]tl) {#1};
    \node[font=\bfseries\fontsize{18}{22}\selectfont]
      at ([yshift=-112mm]current page.north) {#2};
    \node[anchor=base east, font=\bfseries\fontsize{24}{28}\selectfont]
      at ([xshift=-25.4mm, yshift=-143mm]current page.north east) {#3};
    \node[anchor=north east, align=right, font=\bfseries\fontsize{12}{14.6}\selectfont]
      at ([xshift=-25.4mm, yshift=-148mm]current page.north east) {#4};
  \end{tikzpicture}
  \null\clearpage}

% ----------------------------------------------------------------- tables --
% Template tables: thin grey grid, pale-blue header row in SamsungOne-700.
\arrayrulecolor{sicrule}
\setlength{\arrayrulewidth}{0.5pt}
\renewcommand{\arraystretch}{1.3}
\newcommand{\head}[1]{\cellcolor{sichead}\bfseries\centering\arraybackslash #1}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}

% ---------------------------------------------------------------- captions --
\captionsetup{font={small}, labelfont={bf,color=sicblue}, labelsep=period,
              skip=5pt, justification=raggedright, singlelinecheck=false}
\captionsetup[table]{position=top}

% Status marks for progress tables.
\newcommand{\done}{\textcolor{sicblue}{\bfseries Done}}
\newcommand{\wip}{\textcolor{figwarm}{\bfseries In progress}}
\newcommand{\todo}{\textcolor{figgrey}{\bfseries Not started}}

% A boxed finding, for the few results a reader must not miss.
\newcommand{\finding}[1]{%
  \par\vspace{3pt}\noindent
  \fcolorbox{sicblue}{figpale}{\parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{%
    \setlength{\parskip}{3pt}\vspace{2pt}#1\vspace{2pt}}}\par\vspace{3pt}}
% The bibliography sits under a References subsection, not a new banner.
\RequirePackage{etoolbox}
\patchcmd{\thebibliography}{\section*{\refname}\@mkboth{\MakeUppercase\refname}{\MakeUppercase\refname}}{}{}{}
\endinput
