# Python / uv
.venv/
__pycache__/
*.pyc

# Secrets — never commit real API keys; see .env.example for the template.
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# LaTeX build artifacts (references/03_project_architecture/*.tex are the source of truth)
references/03_project_architecture/*.aux
references/03_project_architecture/*.log
references/03_project_architecture/*.out
references/03_project_architecture/*.toc
references/03_project_architecture/*.pdf
references/03_project_architecture/*.fls
references/03_project_architecture/*.fdb_latexmk
references/03_project_architecture/*.synctex.gz

# Data — large and/or regenerable; see data/README.md for how to refetch
# data/raw/ and regenerate data/processed/.
data/raw/
data/processed/

# Locked test sets — never commit; see data/test_manifest.json for hashes instead.
data/test_locked/

# Trained model artifacts — large (hundreds of MB to GB), regenerable from scripts/train_*.py
# and scripts/optimize_*.py; see the level-classifier-benchmark memory note for how each one
# was produced. Never belongs in git history.
models/