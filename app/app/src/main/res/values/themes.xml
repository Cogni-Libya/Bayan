<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Bayan" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- The system splash: the launcher icon on the theme's background, as for any app. -->
    <style name="Theme.Bayan.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.Bayan</item>
    </style>

    <!-- The "تبسيط" sheet opens over the app the text came from. -->
    <style name="Theme.Bayan.Overlay" parent="Theme.Bayan">
        <item name="android:windowIsTranslucent">true</item>
        <!-- No window animation: the overlay draws its own entrance (panel, then light), timed from the first frame. -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <!-- Transparent system bars from the very first frame (edge-to-edge is set again once the settings load). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>
