<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bayan_surface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- App Header & Settings Action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAppTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/bayan_primary"
                        android:gravity="start"
                        android:textDirection="rtl" />

                    <TextView
                        android:id="@+id/tvAppSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/app_subtitle"
                        android:textSize="14sp"
                        android:textColor="@color/bayan_on_surface_variant"
                        android:gravity="start"
                        android:textDirection="rtl"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/action_settings"
                    app:tint="@color/bayan_primary" />
            </LinearLayout>

            <!-- Model Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bayan_card_border"
                app:cardBackgroundColor="@color/bayan_surface_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivStatusIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_status_ready"
                            android:contentDescription="@string/model_status_title" />

                        <TextView
                            android:id="@+id/tvModelStatusHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/model_status_title"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/bayan_primary"
                            android:gravity="start"
                            android:textDirection="rtl" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvModelStatusName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/model_status_name"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/bayan_on_surface"
                        android:gravity="start"
                        android:textDirection="rtl" />

                    <TextView
                        android:id="@+id/tvModelStatusDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/model_status_ready"
                        android:textSize="13sp"
                        android:textColor="@color/bayan_status_green"
                        android:gravity="start"
                        android:textDirection="rtl" />

                    <TextView
                        android:id="@+id/tvModelStatusSpecs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/model_status_specs"
                        android:textSize="12sp"
                        android:textColor="@color/bayan_text_muted"
                        android:gravity="start"
                        android:textDirection="rtl" />

                    <!-- Progress indicator for Downloading state -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressBarModelDownload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        app:indicatorColor="@color/bayan_primary"
                        app:trackColor="@color/bayan_primary_container"
                        tools:visibility="visible"
                        tools:progress="45" />

                    <!-- Download action button for Not Downloaded state -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadModel"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="تنزيل النموذج (62 ميجابايت)"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Text Input Sandbox Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInputSandbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bayan_card_border"
                app:cardBackgroundColor="@color/bayan_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSandboxTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sandbox_title"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/bayan_on_surface"
                        android:gravity="start"
                        android:textDirection="rtl" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilInputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etInputText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/input_hint"
                            android:minLines="4"
                            android:gravity="top|start"
                            android:textDirection="rtl"
                            android:textSize="16sp"
                            android:inputType="textMultiLine" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:gravity="end">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPaste"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_paste"
                            app:icon="@drawable/ic_paste"
                            android:layout_marginEnd="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimplify"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_simplify"
                            app:icon="@drawable/ic_simplify" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Usage Instructions -->
            <TextView
                android:id="@+id/tvInstructionsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/instructions_title"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/bayan_on_surface"
                android:gravity="start"
                android:textDirection="rtl" />

            <TextView
                android:id="@+id/tvInstruction1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/instruction_step_1"
                android:textSize="13sp"
                android:textColor="@color/bayan_on_surface_variant"
                android:gravity="start"
                android:textDirection="rtl" />

            <TextView
                android:id="@+id/tvInstruction2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/instruction_step_2"
                android:textSize="13sp"
                android:textColor="@color/bayan_on_surface_variant"
                android:gravity="start"
                android:textDirection="rtl" />

            <TextView
                android:id="@+id/tvInstruction3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/instruction_step_3"
                android:textSize="13sp"
                android:textColor="@color/bayan_on_surface_variant"
                android:gravity="start"
                android:textDirection="rtl" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

