<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Top Drag Handle -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Sheet Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvSheetHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sheet_header_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/bayan_primary"
            android:gravity="start"
            android:textDirection="rtl" />

        <ImageView
            android:id="@+id/ivBayanBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_simplify"
            android:contentDescription="@string/app_name"
            app:tint="@color/bayan_primary" />
    </LinearLayout>

    <!-- Scrollable State Views Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- State 1: NeedsModel Container -->
            <LinearLayout
                android:id="@+id/layoutNeedsModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNeedsModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/bayan_primary"
                    app:cardBackgroundColor="@color/bayan_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvNeedsModelTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="تنزيل نموذج الذكاء الاصطناعي مطلوب"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/bayan_primary"
                            android:gravity="start"
                            android:textDirection="rtl" />

                        <TextView
                            android:id="@+id/tvNeedsModelPrompt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="يلزم تنزيل نموذج الذكاء الاصطناعي أولاً للبدء بالتبسيط دون إنترنت."
                            android:textSize="14sp"
                            android:textColor="@color/bayan_on_surface"
                            android:lineSpacingMultiplier="1.4"
                            android:gravity="start"
                            android:textDirection="rtl" />

                        <TextView
                            android:id="@+id/tvNeedsModelSpecs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="حجم التنزيل: ~62 ميجابايت (يعمل محلياً دون إنترنت)"
                            android:textSize="12sp"
                            android:textColor="@color/bayan_text_muted"
                            android:gravity="start"
                            android:textDirection="rtl" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDownloadModel"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="تنزيل" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- State 2: Loading Container -->
            <LinearLayout
                android:id="@+id/layoutLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="32dp"
                android:paddingBottom="32dp"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressBarLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/bayan_primary"
                    app:trackColor="@color/bayan_surface_variant"
                    app:trackCornerRadius="4dp" />

                <TextView
                    android:id="@+id/tvLoadingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="جاري تبسيط النص..."
                    android:textSize="14sp"
                    android:textColor="@color/bayan_primary"
                    android:gravity="center"
                    android:textDirection="rtl" />
            </LinearLayout>

            <!-- State 3: Result Container -->
            <LinearLayout
                android:id="@+id/layoutResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Interactive Text Toggle Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleText"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="النص الأصلي / النص المبسّط" />

                <!-- Enlarged Text Card (Dyslexia-Friendly) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLargeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/bayan_primary"
                    app:cardBackgroundColor="@color/bayan_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvLargeLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/simplified_text_title"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/bayan_primary"
                            android:gravity="start"
                            android:textDirection="rtl" />

                        <!-- Active Enlarged TextView with Dyslexia Typography -->
                        <TextView
                            android:id="@+id/tvLargeText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="22sp"
                            android:textColor="@color/bayan_on_surface"
                            android:textDirection="rtl"
                            android:gravity="start|top"
                            android:lineSpacingMultiplier="1.6"
                            android:lineSpacingExtra="10sp"
                            android:letterSpacing="0.04"
                            android:justificationMode="none"
                            tools:text="هذا نص تجريبي مبسط للقراءة الميسرة مع مسافات مريحة بين الأسطر." />

                        <!-- Backward compatibility view for legacy test bindings -->
                        <TextView
                            android:id="@+id/tvSimplifiedText"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:visibility="gone"
                            android:textSize="22sp"
                            android:textColor="@color/bayan_on_surface"
                            android:textDirection="rtl"
                            android:gravity="start|top"
                            android:lineSpacingMultiplier="1.6"
                            android:lineSpacingExtra="10sp"
                            android:letterSpacing="0.04"
                            android:justificationMode="none" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Muted Smaller Text Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMutedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/bayan_card_border"
                    app:cardBackgroundColor="@color/bayan_surface_variant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvMutedLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/original_text_title"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/bayan_text_muted"
                            android:gravity="start"
                            android:textDirection="rtl" />

                        <TextView
                            android:id="@+id/tvMutedText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="13sp"
                            android:textColor="@color/bayan_text_muted"
                            android:textDirection="rtl"
                            android:gravity="start|top"
                            android:lineSpacingMultiplier="1.3"
                            tools:text="النص الأصلي غير المبسط المستخرج من التطبيق المضيف." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- State 4: Error Container (Preserves original text) -->
            <LinearLayout
                android:id="@+id/layoutError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#B00020"
                    app:cardBackgroundColor="#FDE8E8">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvErrorTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="تعذر تبسيط النص"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#B00020"
                            android:gravity="start"
                            android:textDirection="rtl" />

                        <TextView
                            android:id="@+id/tvErrorMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="تعذر تبسيط النص حالياً، يرجى المحاولة لاحقاً."
                            android:textSize="13sp"
                            android:textColor="#B00020"
                            android:lineSpacingMultiplier="1.3"
                            android:gravity="start"
                            android:textDirection="rtl" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Original Captured Text Card (Preserved so user text is never lost) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardErrorOriginalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/bayan_card_border"
                    app:cardBackgroundColor="@color/bayan_surface_variant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvErrorOriginalLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="النص الأصلي المحفوظ:"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/bayan_text_muted"
                            android:gravity="start"
                            android:textDirection="rtl" />

                        <TextView
                            android:id="@+id/tvOriginalText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="14sp"
                            android:textColor="@color/bayan_on_surface"
                            android:textDirection="rtl"
                            android:gravity="start|top"
                            android:lineSpacingMultiplier="1.4"
                            tools:text="النص الأصلي المحفوظ للمستخدم." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Control Buttons Row -->
    <LinearLayout
        android:id="@+id/layoutControlRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListen"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:enabled="false"
            app:icon="@drawable/ic_listen"
            android:text="@string/action_listen" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopy"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:enabled="false"
            app:icon="@drawable/ic_copy"
            android:text="@string/action_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:enabled="false"
            app:icon="@drawable/ic_settings"
            android:text="@string/action_settings" />
    </LinearLayout>

    <!-- Feature in development footnote -->
    <TextView
        android:id="@+id/tvDisabledNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/action_disabled_notice"
        android:textSize="11sp"
        android:textColor="@color/bayan_text_muted"
        android:gravity="center"
        android:textDirection="rtl" />

</LinearLayout>
