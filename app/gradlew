##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for relative symlinks.
while [ -h "$app_path" ]; do
    ls=`ls -ld "$app_path"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        app_path="$link"
    else
        app_path=`dirname "$app_path"`"/$link"
    fi
done

# This is normally concurred by native functions
APP_BASE_NAME=`basename "$0"`
APP_HOME=`dirname "$app_path"`

if [ -z "$JAVA_HOME" ] && [ -d "/c/Program Files/Java/jdk-17" ]; then
    JAVA_HOME="/c/Program Files/Java/jdk-17"
elif [ -z "$JAVA_HOME" ] && [ -d "C:/Program Files/Java/jdk-17" ]; then
    JAVA_HOME="C:/Program Files/Java/jdk-17"
fi

# Reset the native functions to default
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi
which "$JAVACMD" >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH."

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Execute Gradle
exec "$JAVACMD" "-Dorg.gradle.appname=$APP_BASE_NAME" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
